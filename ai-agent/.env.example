# Gemini API
GOOGLE_API_KEY=your_gemini_api_key

# LLM 모델 (필수. 서비스 모델: google_genai / gemini-3.5-flash-lite)
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite

# Stove(로스트아크) 공식 개발자 API
LOSTARK_API_KEY=your_lostark_api_key

# RAG 설정
COLLECTION_NAME=loa_guides
CHROMA_PERSIST_DIR=data/chroma_db
RAID_DATA_DIR=data/raids
EMBEDDING_MODEL=bge-m3

# 대화 기록 저장 파일 (필수, ai-agent 폴더 기준 상대 경로)
CHECKPOINT_DB_PATH=data/chat_history.sqlite

# Spring → FastAPI 내부 호출용 API Key (필수, Spring의 application-secret.properties fastapi.api-key와 같은 값)
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
FASTAPI_API_KEY=your_internal_api_key
